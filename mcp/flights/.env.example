# Optional URL overrides. Kiwi and Skiplagged public MCP need no token.
# Copy to .env locally; never commit .env.
KIWI_MCP_URL=https://mcp.kiwi.com
SKIPLAGGED_MCP_URL=https://mcp.skiplagged.com/mcp

# Optional. Only set if a provider starts requiring auth.
# Prefer env interpolation in mcp.json.local rather than pasting tokens.
# KIWI_MCP_TOKEN=
# SKIPLAGGED_MCP_TOKEN=
